<?xml version="1.0" encoding="utf-8"?>
<!-- Hardened network security policy:
     - Require HTTPS globally (cleartextTrafficPermitted="false") to prevent plaintext MITM on public networks.
     - Restrict cleartext HTTP strictly to local loopback and mDNS (.local) self-hosted LAN hosts.
     - Trust system CAs plus user-installed CAs (behind system lock/warning) for private home PKI (Caddy tls internal). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
