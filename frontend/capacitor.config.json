{
  "appId": "io.github.rahulbongu.mygym",
  "appName": "My Gym",
  "webDir": "dist",
  "backgroundColor": "#0D110F",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0D110F",
      "showSpinner": false
    }
  }
}
